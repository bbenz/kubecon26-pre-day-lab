# Azure-side settings for this challenge (read by the bash, PowerShell and
# Terraform deployments). This is the federated identity credential subject on
# the "id-ctf-config-reader" managed identity.
#
# SEEDED FAULT: the subject still points at the namespace the app was moved
# out of (config-legacy). The app now runs as
# system:serviceaccount:a4-config:config-reader.
A4_FEDERATED_SUBJECT=system:serviceaccount:config-legacy:config-reader
